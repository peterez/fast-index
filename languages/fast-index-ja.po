#. Plugin Name of the plugin
#: index.php
msgid "Fast Index for Google Indexing API"
msgstr "Fast Index for Google Indexing API"

#. Description of the plugin
#: index.php
msgid "Sends new, updated and deleted posts to the Google Indexing API so Google can crawl them sooner."
msgstr "新規・更新・削除された投稿をGoogle Indexing APIに送信し、Googleがより早くクロールできるようにします。"

#. Author of the plugin
#: index.php
msgid "Samet AKIN"
msgstr "Samet AKIN"

