#. Plugin Name of the plugin
#: index.php
msgid "Fast Index for Google Indexing API"
msgstr "Fast Index for Google Indexing API"

#. Description of the plugin
#: index.php
msgid ""
"Sends new, updated and deleted posts to the Google Indexing API so Google "
"can crawl them sooner."
msgstr ""
"Yeni, güncellenen ve silinen yazıları Google Indexing API'ye bildirir; "
"böylece Google bunları daha erken tarayabilir."

#. Author of the plugin
#: index.php
msgid "Samet AKIN"
msgstr "Samet AKIN"

