#. Plugin Name of the plugin
#: index.php
msgid "Fast Index for Google Indexing API"
msgstr "Fast Index for Google Indexing API"

#. Description of the plugin
#: index.php
msgid ""
"Sends new, updated and deleted posts to the Google Indexing API so Google "
"can crawl them sooner."
msgstr ""
"Отправляет новые, изменённые и удалённые записи в Google Indexing API, чтобы "
"Google мог просканировать их быстрее."

#. Author of the plugin
#: index.php
msgid "Samet AKIN"
msgstr "Samet AKIN"

#. Author URI of the plugin
#: index.php
msgid "https://www.linkedin.com/in/samet-akin/"
msgstr "https://www.linkedin.com/in/samet-akin/"

