#. Plugin Name of the plugin
#: index.php includes/class-fast-index-admin.php:70
msgid "Fast Index"
msgstr "Fast Index"

#. Description of the plugin
#: index.php
msgid "Sends new, updated and deleted posts to the Google Indexing API so Google can crawl them sooner."
msgstr "Отправляет новые, изменённые и удалённые записи в Google Indexing API, чтобы Google мог просканировать их быстрее."

#. Author of the plugin
#: index.php
msgid "Samet AKIN"
msgstr "Samet AKIN"

