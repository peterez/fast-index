#. Plugin Name of the plugin
#: index.php
#: includes/class-fast-index-admin.php:70
msgid "Fast Index"
msgstr "Fast Index"

#. Description of the plugin
#: index.php
msgid "Sends new, updated and deleted posts to the Google Indexing API so Google can crawl them sooner."
msgstr "Sendet neue, aktualisierte und gelöschte Beiträge an die Google Indexing API, damit Google sie früher crawlen kann."

#. Author of the plugin
#: index.php
msgid "Samet AKIN"
msgstr "Samet AKIN"

