#: includes/class-fast-index-help-content.php:191
msgid "Upload the key to Fast Index"
msgstr "Den Schlüssel in Fast Index hochladen"

#. translators: 1: heading on the settings screen, 2: label of the file field, 3: submit button label.
#: includes/class-fast-index-help-content.php:194
#, php-format
msgid ""
"Open the Fast Index settings. Under %1$s choose the .json file (%2$s) and "
"click %3$s. The screen then lists the email address and key ID of the key. "
"The private key is stored in your database and is never shown."
msgstr ""
"Öffne die Einstellungen von Fast Index. Wähle unter %1$s die .json-Datei "
"(%2$s) und klicke auf %3$s. Danach werden die E-Mail-Adresse und die "
"Schlüssel-ID des Schlüssels aufgelistet. Der private Schlüssel wird in "
"deiner Datenbank gespeichert und nie angezeigt."

