#. Plugin Name of the plugin
#: index.php
msgid "Fast Index for Google Indexing API"
msgstr "Fast Index for Google Indexing API"

#. Description of the plugin
#: index.php
msgid ""
"Sends new, updated and deleted posts to the Google Indexing API so Google "
"can crawl them sooner."
msgstr ""
"Sendet neue, aktualisierte und gelöschte Beiträge an die Google Indexing "
"API, damit Google sie früher crawlen kann."

