#. Plugin Name of the plugin
#: index.php
msgid "Fast Index for Google Indexing API"
msgstr "Fast Index for Google Indexing API"

#. Description of the plugin
#: index.php
msgid ""
"Sends new, updated and deleted posts to the Google Indexing API so Google "
"can crawl them sooner."
msgstr ""
"يرسل المقالات الجديدة والمحدّثة والمحذوفة إلى Google Indexing API ليتمكن "
"Google من الزحف إليها في وقت أبكر."

#. Author of the plugin
#: index.php
msgid "Samet AKIN"
msgstr "Samet AKIN"

#. Author URI of the plugin
#: index.php
msgid "https://www.linkedin.com/in/samet-akin/"
msgstr "https://www.linkedin.com/in/samet-akin/"

