#. Plugin Name of the plugin
#: index.php
msgid "Fast Index for Google Indexing API"
msgstr "Fast Index for Google Indexing API"

#: includes/class-fast-index-admin.php:70
msgid "Fast Index"
msgstr "Fast Index"

#. Description of the plugin
#: index.php
msgid "Sends new, updated and deleted posts to the Google Indexing API so Google can crawl them sooner."
msgstr "Envia à Google Indexing API posts novos, atualizados e excluídos para que o Google possa rastreá-los mais cedo."

#. Author of the plugin
#: index.php
msgid "Samet AKIN"
msgstr "Samet AKIN"

