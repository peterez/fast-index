#: includes/class-fast-index-help-content.php:180
msgid "Search Console Help"
msgstr "Ajuda do Search Console"

#: includes/class-fast-index-help-content.php:185
msgid "Upload the key to Fast Index"
msgstr "Envie a chave para o Fast Index"

#. translators: 1: heading on the settings screen, 2: label of the file field, 3: submit button label.
#: includes/class-fast-index-help-content.php:188
#, php-format
msgid "Open the Fast Index settings. Under %1$s choose the .json file (%2$s) and click %3$s. The screen then lists the email address and key ID of the key. The private key is stored in your database and is never shown."
msgstr "Abra as configurações do Fast Index. Em %1$s, escolha o arquivo .json (%2$s) e clique em %3$s. A tela então lista o e-mail e o ID da chave. A chave privada é guardada no seu banco de dados e nunca é exibida."

#: includes/class-fast-index-help-content.php:189
#: includes/class-fast-index-help-content.php:287 view/settings.php:158
msgid "Upload Google Service Account Key"
