#. Plugin Name of the plugin
#: index.php
msgid "Fast Index for Google Indexing API"
msgstr "Fast Index for Google Indexing API"

#: includes/class-fast-index-admin.php:70
msgid "Fast Index"
msgstr "Fast Index"

#. Description of the plugin
#: index.php
msgid "Sends new, updated and deleted posts to the Google Indexing API so Google can crawl them sooner."
msgstr "Invia gli articoli nuovi, aggiornati ed eliminati alla Google Indexing API, così Google può eseguirne prima la scansione."

