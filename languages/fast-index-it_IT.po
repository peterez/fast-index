#: includes/class-fast-index-help-content.php:186
msgid "Search Console Help"
msgstr "Guida di Search Console"

#: includes/class-fast-index-help-content.php:191
msgid "Upload the key to Fast Index"
msgstr "Carica la chiave in Fast Index"

#. translators: 1: heading on the settings screen, 2: label of the file field, 3: submit button label.
#: includes/class-fast-index-help-content.php:194
#, php-format
msgid ""
"Open the Fast Index settings. Under %1$s choose the .json file (%2$s) and "
"click %3$s. The screen then lists the email address and key ID of the key. "
"The private key is stored in your database and is never shown."
msgstr ""
"Apri le impostazioni di Fast Index. Nella sezione %1$s scegli il file .json "
"(%2$s) e fai clic su %3$s. La schermata elenca poi l’indirizzo email e l’ID "
"della chiave. La chiave privata viene memorizzata nel database e non viene "
"mai mostrata."

#: includes/class-fast-index-help-content.php:195
#: includes/class-fast-index-help-content.php:298 view/settings.php:152
msgid "Upload Google Service Account Key"
msgstr "Carica la chiave dell’account di servizio Google"

#: includes/class-fast-index-help-content.php:196 view/settings.php:200
msgid "JSON Key File"
msgstr "File chiave JSON"

#: includes/class-fast-index-help-content.php:197 view/settings.php:213
msgid "Upload key"
