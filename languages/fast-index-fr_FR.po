#. Plugin Name of the plugin
#: index.php
msgid "Fast Index for Google Indexing API"
msgstr "Fast Index for Google Indexing API"

#: includes/class-fast-index-admin.php:70
msgid "Fast Index"
msgstr "Fast Index"

#. Description of the plugin
#: index.php
msgid "Sends new, updated and deleted posts to the Google Indexing API so Google can crawl them sooner."
msgstr "Envoie les articles nouveaux, modifiés et supprimés à la Google Indexing API afin que Google puisse les explorer plus tôt."

