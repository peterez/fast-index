#. Plugin Name of the plugin
#: index.php includes/class-fast-index-admin.php:70
msgid "Fast Index"
msgstr "Fast Index"

#. Description of the plugin
#: index.php
msgid "Sends new, updated and deleted posts to the Google Indexing API so Google can crawl them sooner."
msgstr "Verzendt nieuwe, bijgewerkte en verwijderde berichten naar de Google Indexing API, zodat Google ze eerder kan crawlen."

