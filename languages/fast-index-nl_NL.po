#. translators: 1: tab name "Keys", 2: menu entry "Add key", 3: menu entry "Create new key", 4: key type "JSON", 5: button name "Create".
#: includes/class-fast-index-help-content.php:163
#, php-format
msgid "Click the email address of the new service account and open the %1$s tab. Click %2$s, choose %3$s, select %4$s as the key type and click %5$s. The file downloads once and Google cannot give it to you again. Keep it private and never share or post it. If Google says you cannot create keys, your organization may block key creation with a policy; ask your Google Cloud administrator."
msgstr "Klik op het e-mailadres van het nieuwe serviceaccount en open het tabblad %1$s. Klik op %2$s, kies %3$s, selecteer %4$s als sleuteltype en klik op %5$s. Het bestand wordt één keer gedownload en Google kan het je niet opnieuw geven. Houd het privé en deel of plaats het nooit ergens. Als Google zegt dat je geen sleutels kunt maken, blokkeert je organisatie het maken van sleutels mogelijk met een beleid; vraag het aan je Google Cloud-beheerder."

#: includes/class-fast-index-help-content.php:164
msgid "Keys"
msgstr "Sleutels"

#: includes/class-fast-index-help-content.php:165
msgid "Add key"
msgstr "Sleutel toevoegen (Add key)"

#: includes/class-fast-index-help-content.php:166
